{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "arithmetic-followup",
      "description": "Direct Danish answer and a contextual follow-up in one session.",
      "turns": [
        {
          "text": "Hvad er tolv gange syv?",
          "expect": {
            "direct_answer": true,
            "answer_any": ["84", "fireogfirs"],
            "remain_open": true
          }
        },
        {
          "text": "Og læg seks til.",
          "expect": {
            "direct_answer": true,
            "answer_any": ["90", "halvfems"],
            "remain_open": true
          }
        }
      ]
    },
    {
      "id": "time-followup",
      "description": "A current fact uses the safe clock tool and context survives.",
      "turns": [
        {
          "text": "Hvad er klokken?",
          "expect": {
            "decision": "get_time",
            "tool_args": {"get_time": {"fields": ["time"]}},
            "answer_any": ["fjorten", "14"],
            "remain_open": true
          }
        },
        {
          "text": "Og hvilken ugedag er det?",
          "expect": {
            "decision": "get_time",
            "tool_args": {"get_time": {"fields": ["weekday"]}},
            "answer_any": ["mandag"],
            "remain_open": true
          }
        },
        {
          "text": "Og hvilket ugenummer er det?",
          "expect": {
            "decision": "get_time",
            "tool_args": {"get_time": {"fields": ["week_number"]}},
            "answer_any": ["34", "fireogtredive"],
            "remain_open": true
          }
        }
      ]
    },
    {
      "id": "semantic-close",
      "description": "Politeness stays open; an explicit wrap-up closes exactly once.",
      "turns": [
        {
          "text": "Tak. Hvad er to plus to?",
          "expect": {
            "direct_answer": true,
            "forbid": ["end_conversation"],
            "answer_any": ["4", "fire"],
            "remain_open": true
          }
        },
        {
          "text": "Tak, det var alt for nu.",
          "expect": {
            "decision": "end_conversation",
            "answer_any": ["farvel", "vi ses", "hej hej"],
            "remain_open": false
          }
        }
      ]
    },
    {
      "id": "web-routing",
      "description": "A current sports result routes to web and uses only its fixture.",
      "turns": [
        {
          "text": "Hvordan gik FCK i deres seneste kamp?",
          "expect": {
            "decision": "google_web_sogning",
            "answer_patterns": [
              "(?:fck|fc københavn).*vandt.*(?:2 0|to nul)",
              "(?:2 0|to nul).*til (?:fck|fc københavn)"
            ],
            "forbid": ["get_time"],
            "remain_open": true
          }
        }
      ]
    }
  ]
}
