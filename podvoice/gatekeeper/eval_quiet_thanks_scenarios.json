        },
        {
          "text": "Tak.",
          "expect": {
            "decision": "wait_for_user",
            "decisions": [
              "wait_for_user"
            ],
            "silent_response": true,
            "fixture_side_effects": 0,
            "remain_open": true
          }
        },
        {
          "text": "Og hvilken ugedag er det?",
          "expect": {
            "allowed_decisions": [
              "GetDateTime"
            ],
            "allow_direct": true,
            "answer_any": [
              "mandag"
            ],
            "remain_open": true
